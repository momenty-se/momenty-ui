{
  "name": "@momenty/ui",
  "version": "0.5.0",
  "private": true,
  "description": "Momentys gemensamma komponentbibliotek — formen bor här, färgen i appen.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/momenty-se/momenty-ui.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "sideEffects": [
    "*.css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./css/tokens.css": "./src/css/tokens.css",
    "./css/base.css": "./src/css/base.css",
    "./css/button.css": "./src/css/button.css",
    "./css/field.css": "./src/css/field.css",
    "./css/*.css": "./src/css/*.css",
    "./css/picker.css": "./src/css/picker.css",
    "./css/dialog.css": "./src/css/dialog.css",
    "./css/patterns.css": "./src/css/patterns.css",
    "./css/choice.css": "./src/css/choice.css",
    "./css/switch.css": "./src/css/switch.css",
    "./css/typography.css": "./src/css/typography.css",
    "./css/feedback.css": "./src/css/feedback.css",
    "./css/blocks.css": "./src/css/blocks.css"
  },
  "files": [
    "LICENSE",
    "src",
    "docs",
    "README.md"
  ],
  "scripts": {
    "type-check": "tsc --noEmit",
    "styleguide": "vite --config styleguide/vite.config.mts",
    "styleguide:build": "vite build --config styleguide/vite.config.mts",
    "check:css": "node scripts/check-css.mjs",
    "check": "tsc --noEmit && tsc --noEmit -p styleguide/tsconfig.json && node scripts/check-css.mjs"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^5.4.5",
    "vite": "^8.2.2"
  }
}
